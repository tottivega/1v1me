# Copy to .env and fill in your values

# Supabase — get these from your project's Settings → API page
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Allowed client origin (production only) — rejects WS upgrades + CORS from
# any other origin. Set to your Vercel deployment URL, e.g.:
#   https://1v1me.vercel.app
# Leave unset in dev (all origins allowed).
ALLOWED_ORIGIN=https://your-app.vercel.app

# Server port (optional, defaults to 3001)
PORT=3001
