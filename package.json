{
  "name": "1v1-me",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('husky', {stdio:'inherit'})\"",
    "format": "prettier --write \"server/src/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
    "format:check": "prettier --check \"server/src/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
    "test:e2e": "npm install --prefix tests && npm test --prefix tests",
    "new-game": "node scripts/new-game.mjs"
  },
  "lint-staged": {
    "server/src/**/*.ts": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --config server/eslint.config.mjs"
    ],
    "client/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --config client/eslint.config.js"
    ],
    "shared/**/*.ts": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  }
}
